# Copy to .env.local (git-ignored) and fill in. Vite reads it for `npm run dev` and `npm run build`.
#
# Hosted Supabase project: Project Settings → API.
# The anon key is meant for browsers. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Local Docker stack only (`npm run local:start` writes this for you). Shows the demo
# accounts on the sign-in screen. Leave it out for the hosted project.
# VITE_LOCAL_DEMO=true

# Web push. Public VAPID key (safe for browsers). The private key is a Supabase secret, never put it here.
# Generate a pair with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=
