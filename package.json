{
  "name": "planit-crew-hazards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "local:start": "supabase start -x edge-runtime,imgproxy,logflare,vector && node scripts/local-env.mjs",
    "local:reset": "node scripts/reset-local.mjs",
    "local:env": "node scripts/local-env.mjs",
    "types": "supabase gen types typescript --local > src/database.types.ts",
    "test": "node --test --test-concurrency=1 tests/backend.test.mjs",
    "test:ui": "playwright test",
    "local:cleanup": "node scripts/cleanup-photos.mjs",
    "db:lint": "supabase db lint --local --schema public,private --level warning",
    "format": "prettier --write src scripts tests docs index.html package.json tsconfig.json playwright.config.ts README.md",
    "format:check": "prettier --check src scripts tests docs index.html package.json tsconfig.json playwright.config.ts README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
