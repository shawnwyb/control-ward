{
  "name": "planit-crew-hazards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:design": "vite --mode design --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "local:start": "supabase start -x edge-runtime,imgproxy,logflare,vector && node scripts/local-env.mjs",
    "local:reset": "node scripts/reset-local.mjs",
    "local:env": "node scripts/local-env.mjs",
    "types": "supabase gen types typescript --local > src/database.types.ts",
    "test": "node --test --test-concurrency=1 tests/backend.test.mjs",
    "test:ui": "playwright test",
    "local:cleanup": "node scripts/cleanup-photos.mjs",
    "check:connection": "node scripts/check-connection.mjs",
    "db:lint": "supabase db lint --local --schema public,private --level warning",
    "format": "prettier --write vite.config.ts src scripts tests docs index.html package.json tsconfig.json playwright.config.ts README.md",
    "format:check": "prettier --check vite.config.ts src scripts tests docs index.html package.json tsconfig.json playwright.config.ts README.md",
    "verify:monitoring": "supabase db query --linked -f tests/monitoring.verify.sql",
    "verify:rules": "supabase db query --linked -f tests/rules.verify.sql",
    "verify:crew-assignment": "supabase db query --linked -f tests/crew-assignment.verify.sql",
    "test:nextday": "node --test tests/nextday/*.test.mjs && reports/next-day/run.sh test",
    "test:functions": "node --experimental-strip-types --test tests/functions/*.test.mjs",
    "safety:local:start": "node scripts/safety/local-stack.mjs start",
    "safety:local:stop": "node scripts/safety/local-stack.mjs stop",
    "safety:types": "node scripts/safety/local-stack.mjs types",
    "safety:dev": "vite --mode safety --host 127.0.0.1",
    "test:safety:db": "node --experimental-strip-types --test --test-concurrency=1 tests/safety/*.test.mjs",
    "test:safety:ui": "PLAYWRIGHT_MODE=design playwright test tests/ui-design/safety.spec.ts",
    "safety:ingest": "node --experimental-strip-types scripts/safety/ingest.mjs",
    "test:safety:regression": "node scripts/safety/regression.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "exceljs": "^4.4.0",
    "jsfive": "^0.4.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "tz-lookup": "^6.1.25",
    "vite": "^6.4.4"
  }
}
