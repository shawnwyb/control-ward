# Local Edge-only configuration. Copy to an ignored path and pass --env-file.
# Never use a VITE_ prefix or expose these values in the browser.
SAFETY_AGENT_ENABLED=false
GEMINI_API_KEY=
# Select a currently supported Gemini model with function calling from the official model catalog.
SAFETY_MODEL=
# Conservative USD reservation for a MAXIMUM prompt + output/thinking turn at current pricing.
# Required: empty/invalid configuration produces an explicit failed/retry run, without publication.
SAFETY_RESERVED_USD_PER_TURN=
SAFETY_MAX_SPEND_USD=0.50
CRON_SECRET=
